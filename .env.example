# Common
LOG_LEVEL=INFO
EXCHANGE=binance

# Bot mode — choose one: paper, sandbox, live
BOT_MODE=paper

# Sandbox mode (Binance testnet)
# BOT_MODE=sandbox
# API_KEY_SANDBOX="your_sandbox_api_key"
# API_SECRET_SANDBOX="your_sandbox_api_secret"

# Live mode (Binance production)
# BOT_MODE=live
# CONFIRM_LIVE=YES
# API_KEY="your_live_api_key"
# API_SECRET="your_live_api_secret"

# Telegram alerts
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# Daily summary schedule (UTC)
SUMMARY_HOUR=18
SUMMARY_MINUTE=0

# Container user/group IDs for volume permissions
UID=1000
GID=1000
